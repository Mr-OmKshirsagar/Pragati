# ==============================================================================
# PRAGATI Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# 1. Server Configuration
PORT=3001
NODE_ENV=development

# 2. Supabase Configuration & PostgreSQL Connection Pooler
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# 3. Supabase S3 Evidence Vault Storage
SUPABASE_STORAGE_BUCKET=evidence-vault

# 4. Assistive AI Layer (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# 5. Multi-Tenant Governance (Super Admin Master Key)
SUPER_ADMIN_EMAIL=platform-owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password
SUPER_ADMIN_MASTER_KEY=your-secure-super-admin-master-key

# 6. SMTP Email Notifications (First-Login Reset, 2FA Lifecycle & Requisitions)
# If SMTP_HOST is not provided, the system safely falls back to a simulated in-memory dispatcher.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@pragati.edu
EMAIL_FROM=no-reply@pragati.edu

# Optional: Catch-all email address to intercept demo domain notifications during testing/evaluations
DEMO_NOTIFICATION_EMAIL=demo-catchall@pragati.edu
ACTIVITY_INVITE_EMAILS=student1@example.com,student2@example.com
